  pkce_secret_object_ref text [not null, note: 'pkce secret object ref Fuente: SRC_ADR_020, DD-020, github-connector-draft-0.2 — aprobación local 2026-11-07: Propuesta aprobada']
  pkce_secret_version_ref text [null, note: 'pkce secret version ref Fuente: SRC_ADR_020, DD-020, github-connector-draft-0.2 — aprobación local 2026-11-07: Propuesta aprobada']
  pkce_cleanup_state text [not null, note: 'pkce cleanup state Fuente: SRC_ADR_020, DD-020, github-connector-draft-0.2 — aprobación local 2026-11-07: Propuesta aprobada']
  pkce_cleanup_result text [null, note: 'pkce cleanup result Fuente: SRC_ADR_020, DD-020, github-connector-draft-0.2 — aprobación local 2026-11-07: Propuesta aprobada']
  approved_return_ref text [not null, note: 'approved return ref Fuente: SRC_ADR_020, DD-020, github-connector-draft-0.2 — aprobación local 2026-11-07: Propuesta aprobada']
  correlation_id text [not null, note: 'correlation id Fuente: SRC_ADR_020, DD-020, github-connector-draft-0.2 — aprobación local 2026-11-07: Propuesta aprobada']
