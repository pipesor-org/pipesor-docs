  indexes {
    (document_id, chunk_index) [unique, name: 'knowledge_chunks_document_id_chunk_index_uq']
  }
  checks {
    `chunk_index >= 0` [name: 'knowledge_chunks_check_1']
    `btrim(provenance) <> ''` [name: 'knowledge_chunks_check_2']
  }
  Note: 'Chunks recuperables de documentos autorizados; conserva provenance y embeddings pgvector compatibles con el contrato aprobado. Owner: rag_retrieval. approved_domain / confirmed.'
