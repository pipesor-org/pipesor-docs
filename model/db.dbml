    (target_generation_id) [unique, name: 'github_attempts_target_generation_uq']
    (state_digest) [unique, name: 'github_attempts_state_digest_uq']
    (pkce_secret_object_ref) [unique, name: 'github_attempts_pkce_object_ref_uq']
  }
  checks {
    `phase IN ('PREPARING','READY','CLAIMED','COMPLETED','FAILED','EXPIRED')` [name: 'github_authorization_attempts_phase_ck']
    `pkce_cleanup_state IN ('HELD','PENDING','COMPLETED','BLOCKED')` [name: 'github_authorization_attempts_cleanup_state_ck']
    `pkce_cleanup_result IS NULL OR pkce_cleanup_result IN ('CONFIRMED','UNAVAILABLE','SCOPE_UNAPPROVED','NOT_APPLICABLE')` [name: 'github_authorization_attempts_cleanup_result_ck']
    `expected_connection_revision >= 0` [name: 'github_authorization_attempts_revision_ck']
    `phase NOT IN ('READY','CLAIMED','COMPLETED') OR pkce_secret_version_ref IS NOT NULL` [name: 'github_authorization_attempts_verifier_required_ck']
    `phase NOT IN ('CLAIMED','COMPLETED') OR consumed_at IS NOT NULL` [name: 'github_authorization_attempts_consumed_required_ck']
    `phase NOT IN ('PREPARING','READY') OR consumed_at IS NULL` [name: 'github_authorization_attempts_unconsumed_ck']
    `phase NOT IN ('COMPLETED','FAILED','EXPIRED') OR pkce_cleanup_state <> 'HELD'` [name: 'github_authorization_attempts_cleanup_intent_ck']
    `pkce_cleanup_state <> 'COMPLETED' OR (pkce_cleanup_result IS NOT NULL AND pkce_cleanup_result IN ('CONFIRMED','NOT_APPLICABLE'))` [name: 'github_authorization_attempts_cleanup_complete_ck']
    `btrim(pkce_secret_object_ref) <> ''` [name: 'github_authorization_attempts_object_ref_ck']
    `pkce_secret_version_ref IS NULL OR (btrim(pkce_secret_version_ref) <> '' AND lower(btrim(pkce_secret_version_ref)) <> 'latest')` [name: 'github_authorization_attempts_version_ref_ck']
    `btrim(approved_return_ref) <> ''` [name: 'github_authorization_attempts_return_ref_ck']
    `btrim(correlation_id) <> ''` [name: 'github_authorization_attempts_correlation_ck']
    `expires_at > created_at` [name: 'github_authorization_attempts_expiry_ck']
    `updated_at >= created_at` [name: 'github_authorization_attempts_timestamps_ck']
    `pkce_cleanup_state <> 'COMPLETED' OR phase IN ('COMPLETED','FAILED','EXPIRED')` [name: 'github_attempts_cleanup_terminal_ck']
    `pkce_secret_object_ref = 'pkce:' || id::text` [name: 'github_attempts_pkce_object_owner_ck']
  }
  Note: 'Metadata técnica del conector GitHub: github_authorization_attempts Owner: ingestion_normalization_service. approved_domain / confirmed. Composite FK github_attempts_identity_fk; DEFERRABLE INITIALLY DEFERRED in extras.sql. Composite FK github_attempts_expected_generation_fk; DEFERRABLE INITIALLY DEFERRED in extras.sql. Composite FK github_attempts_target_generation_fk; DEFERRABLE INITIALLY DEFERRED in extras.sql. Constraints complementarias en extras.sql: connector_lifecycle.'
}

