  scope_revision text [not null, note: 'Revisión histórica inmutable del alcance; reautorización vigente separada. Fuente: architecture.yml#evidence_correlation_engine, SRC_ADR_015, DD-014, DD-023']
  indexes {
    (group_id, id) [unique, name: 'correlated_contexts_group_id_uq']
  }
  checks {
    `array_ndims(evidence_ids) = 1 AND array_lower(evidence_ids, 1) = 1 AND cardinality(evidence_ids) > 0` [name: 'correlated_contexts_evidence_shape_ck']
    `signal_stage IN ('BUILD', 'TESTING', 'QUALITY_GATE', 'DEPLOYMENT', 'CONTAINER', 'INFRASTRUCTURE')` [name: 'correlated_contexts_signal_stage_ck']
    `btrim(signal_summary) <> '' AND signal_summary ~ '[^[:space:]]'` [name: 'correlated_contexts_signal_summary_ck']
    `btrim(signal_content) <> '' AND signal_content ~ '[^[:space:]]'` [name: 'correlated_contexts_signal_content_ck']
    `scope_github_installation_id ~ '^[1-9][0-9]{0,31}$'` [name: 'correlated_contexts_scope_installation_ck']
    `scope_github_repository_id ~ '^[1-9][0-9]{0,31}$'` [name: 'correlated_contexts_scope_repository_ck']
    `scope_revision ~ '^[A-Za-z0-9._:-]{1,128}$'` [name: 'correlated_contexts_scope_revision_ck']
  }
  Note: 'Snapshot saneado del contexto correlacionado; conserva los IDs de evidencia utilizados. Owner: evidence_correlation_engine. approved_domain / confirmed. Composite FK correlated_contexts_group_identity_fk; DEFERRABLE INITIALLY DEFERRED in extras.sql. Constraints complementarias en extras.sql: correlation_lifecycle.'
}

Table evidence.correlation_receipts {
  scope_key text [pk, not null, note: 'Partición máquina confiable; coincide con el grupo del contexto. Fuente: architecture.yml#evidence_correlation_engine, SRC_ADR_015, DD-023']
  producer_key text [pk, not null, note: 'Identidad máquina autenticada y estable del productor. Fuente: architecture.yml#evidence_correlation_engine, SRC_ADR_015, DD-023']
  message_id uuid [pk, not null, note: 'Identidad del mensaje del productor; no se presume igual a evidence_id. Fuente: architecture.yml#evidence_correlation_engine, SRC_ADR_015, DD-023']
  evidence_id uuid [not null, note: 'Evidencia fuente individual referenciada por la revisión original. Referencia lógica a evidence.evidence_items.id; sin FK física ni navegación ORM cross-context. Fuente: architecture.yml#evidence_correlation_engine, SRC_ADR_015, DD-023']
  correlation_id text [not null, note: 'Correlación original individual segura; no derivada del snapshot acumulado. Fuente: architecture.yml#evidence_correlation_engine, SRC_ADR_015, DD-023']
  context_id uuid [not null, note: 'Snapshot de primera incorporación de esta evidencia al grupo. Fuente: architecture.yml#evidence_correlation_engine, SRC_ADR_015, DD-023']
  input_fingerprint text [not null, note: 'Comparación privada versionada del input protegido significativo; no prueba autenticidad. Fuente: architecture.yml#evidence_correlation_engine, SRC_ADR_015, DD-023']
  created_at timestamptz [not null, note: 'Instante técnico de recepción inmutable. Fuente: architecture.yml#evidence_correlation_engine, SRC_ADR_015, DD-023']
  checks {
    `btrim(scope_key) <> '' AND scope_key ~ '[^[:space:]]'` [name: 'correlation_receipts_scope_ck']
    `btrim(producer_key) <> '' AND producer_key ~ '[^[:space:]]'` [name: 'correlation_receipts_producer_ck']
    `btrim(correlation_id) <> '' AND correlation_id ~ '[^[:space:]]'` [name: 'correlation_receipts_correlation_ck']
    `input_fingerprint ~ '^v1:sha256:[0-9a-f]{64}$'` [name: 'correlation_receipts_fingerprint_ck']
  }
  Note: 'Recepción inmutable de mensaje fuente y asociación original; no retiene request, logs ni excerpts. Owner: evidence_correlation_engine. approved_domain / confirmed. Constraints complementarias en extras.sql: correlation_lifecycle.'
}

Table diagnosis.correlated_context_receipts {
  operation_id uuid [pk, not null, note: 'Identidad estable de entrega; coincide con el contexto correlacionado. Fuente: architecture.yml#rel_correlation_recommendation, SRC_ADR_015, DD-024']
  context_id uuid [not null, unique, note: 'Referencia lógica al snapshot propietario de Correlation. Referencia lógica a evidence.correlated_contexts.id; sin FK física ni navegación ORM cross-context. Fuente: architecture.yml#rel_correlation_recommendation, SRC_ADR_015, DD-024']
  request_fingerprint text [not null, note: 'SHA-256 versionado de la representación contractual canónica aceptada. Fuente: architecture.yml#rel_correlation_recommendation, SRC_ADR_015, DD-024']
  tenant_id uuid [not null, note: 'Tenant ya verificado en el alcance máquina. Fuente: architecture.yml#rel_correlation_recommendation, SRC_ADR_015, DD-024']
  github_installation_id text [not null, note: 'Identidad GitHub canónica positiva del alcance autorizado. Fuente: architecture.yml#rel_correlation_recommendation, SRC_ADR_015, DD-024']
  github_repository_id text [not null, note: 'Repositorio GitHub canónico positivo del alcance autorizado. Fuente: architecture.yml#rel_correlation_recommendation, SRC_ADR_015, DD-024']
  pipeline_id uuid [null, note: 'Pipeline autorizado opcional por referencia lógica. Referencia lógica a ops.pipelines.id; sin FK física ni navegación ORM cross-context. Fuente: architecture.yml#rel_correlation_recommendation, SRC_ADR_015, DD-024']
  scope_revision text [not null, note: 'Revisión opaca del alcance verificado por el productor. Fuente: architecture.yml#rel_correlation_recommendation, SRC_ADR_015, DD-024']
  incident_id uuid [not null, note: 'Incidente por referencia lógica; no crea FK cross-context. Referencia lógica a ops.incidents.id; sin FK física ni navegación ORM cross-context. Fuente: architecture.yml#rel_correlation_recommendation, SRC_ADR_015, DD-024']
  execution_id uuid [not null, note: 'Ejecución por referencia lógica; no crea FK cross-context. Referencia lógica a ops.pipeline_executions.id; sin FK física ni navegación ORM cross-context. Fuente: architecture.yml#rel_correlation_recommendation, SRC_ADR_015, DD-024']
  evidence_ids uuid[] [not null, note: 'Referencias lógicas ordenadas a evidencia saneada. Referencia lógica a evidence.evidence_items.id; sin FK física ni navegación ORM cross-context. Fuente: architecture.yml#rel_correlation_recommendation, SRC_ADR_015, DD-024']
  summary text [not null, note: 'Resumen operacional saneado recibido de Correlation. Fuente: architecture.yml#rel_correlation_recommendation, SRC_ADR_015, DD-024']
  correlation_id text [not null, note: 'Identificador transversal original; no contiene secretos. Fuente: architecture.yml#rel_correlation_recommendation, SRC_ADR_015, DD-024']
  context_created_at timestamptz [not null, note: 'Timestamp inmutable del snapshot de Correlation. Fuente: architecture.yml#rel_correlation_recommendation, SRC_ADR_015, DD-024']
  signals jsonb [not null, note: 'Array ordenado de señales protegidas tipadas: evidence_id, origin_context_id, correlation_id, stage, summary y content. Sin request crudo ni claves adicionales. Fuente: architecture.yml#rel_correlation_recommendation, SRC_ADR_015, DD-024']
  created_at timestamptz [not null, note: 'Instante UTC de aceptación durable por Recommendation. Assumption: A-002. Fuente: architecture.yml#rel_correlation_recommendation, SRC_ADR_015, DD-024']
  checks {
    `operation_id = context_id` [name: 'correlated_context_receipts_identity_ck']
    `request_fingerprint ~ '^v1:sha256:[0-9a-f]{64}$'` [name: 'correlated_context_receipts_fingerprint_ck']
    `github_installation_id ~ '^[1-9][0-9]{0,31}$'` [name: 'correlated_context_receipts_installation_ck']
    `github_repository_id ~ '^[1-9][0-9]{0,31}$'` [name: 'correlated_context_receipts_repository_ck']
    `scope_revision ~ '^[A-Za-z0-9._:-]{1,128}$'` [name: 'correlated_context_receipts_scope_ck']
    `cardinality(evidence_ids) > 0` [name: 'correlated_context_receipts_evidence_ck']
    `btrim(summary) <> ''` [name: 'correlated_context_receipts_summary_ck']
    `correlation_id ~ '^[A-Za-z0-9._:-]{1,128}$'` [name: 'correlated_context_receipts_correlation_ck']
    `CASE WHEN jsonb_typeof(signals) = 'array' THEN jsonb_array_length(signals) > 0 AND jsonb_array_length(signals) = cardinality(evidence_ids) ELSE false END` [name: 'correlated_context_receipts_signals_shape_ck']
  }
  Note: 'Recepción durable e idempotente del contexto correlacionado aceptado por Recommendation. Owner: recommendation_service. approved_domain / confirmed. Constraints complementarias en extras.sql: append_only.'
}

Table diagnosis.diagnoses {
  id uuid [pk, not null, note: 'Identificador estable asignado por el servicio propietario. Assumption: A-001. Fuente: architecture.yml#recommendation_service, architecture.yml#INV-005, SRC_ADR_013, DD-003']
  incident_id uuid [not null, note: 'Incidente por referencia lógica; sin asociación JPA cross-context. Referencia lógica a ops.incidents.id; sin FK física ni navegación ORM cross-context. Fuente: architecture.yml#recommendation_service, architecture.yml#INV-005, SRC_ADR_013, DD-003']
  version integer [not null, note: 'Versión positiva, única por incidente; cada nuevo snapshot se inserta. Fuente: architecture.yml#recommendation_service, architecture.yml#INV-005, SRC_ADR_013, DD-003']
  status diagnosis.DiagnosisStatus [not null, note: 'Estado diagnóstico del snapshot. Fuente: architecture.yml#recommendation_service, architecture.yml#INV-005, SRC_ADR_013, DD-003']
  probable_cause text [null, note: 'Hipótesis de causa probable; obligatoria cuando DIAGNOSIS_READY. Assumption: A-007. Fuente: architecture.yml#recommendation_service, architecture.yml#INV-005, SRC_ADR_013, DD-003']
  explanation text [null, note: 'Explicación saneada del diagnóstico. Fuente: architecture.yml#recommendation_service, architecture.yml#INV-005, SRC_ADR_013, DD-003']
  limitations text [null, note: 'Limitaciones de evidencia/inferencia. Fuente: architecture.yml#recommendation_service, architecture.yml#INV-005, SRC_ADR_013, DD-003']
  confidence jsonb [null, note: 'Valor informado por el proveedor, sin imponer tipo numérico, escala ni rango. Assumption: A-008. Fuente: architecture.yml#recommendation_service, architecture.yml#INV-005, SRC_ADR_013, DD-003']
  diagnosis_ready_at timestamptz [null, note: 'Instante de disponibilidad de esta versión; TMD se calcula con detected_at del incidente. Assumption: A-002. Fuente: architecture.yml#recommendation_service, architecture.yml#INV-005, SRC_ADR_013, DD-003']
  correlation_id text [not null, note: 'Identificador de correlación end-to-end; no contiene información sensible. Fuente: architecture.yml#CTRL-003']
  created_at timestamptz [not null, note: 'Instante de persistencia; permite aplicar retención cuando corresponde. Assumption: A-002. Fuente: SRC_ADR_013, DD-015']
  indexes {
    (incident_id, version) [unique, name: 'diagnoses_incident_id_version_uq']
  }
  checks {
    `version > 0` [name: 'diagnoses_check_1']
    `status <> 'DIAGNOSIS_READY' OR (probable_cause IS NOT NULL AND btrim(probable_cause) <> '' AND diagnosis_ready_at IS NOT NULL)` [name: 'diagnoses_check_2']
  }
  Note: 'Snapshot diagnóstico versionado append-only; actual = versión mayor por incidente. Owner: recommendation_service. approved_domain / confirmed. Constraints complementarias en extras.sql: append_only.'
}

