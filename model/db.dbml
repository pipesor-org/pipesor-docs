Ref correlation_receipts_context_id: evidence.correlation_receipts.context_id > evidence.correlated_contexts.id
Ref github_generation_connection: ingestion.github_connection_generations.connection_id > ingestion.github_connections.id
Ref pipelines_repository_id: ops.pipelines.repository_id > ops.repositories.id
Ref pipeline_executions_pipeline_id: ops.pipeline_executions.pipeline_id > ops.pipelines.id
Ref execution_stages_execution_id: ops.execution_stages.execution_id > ops.pipeline_executions.id
Ref incidents_pipeline_id: ops.incidents.pipeline_id > ops.pipelines.id
Ref incident_runs_incident_id: ops.incident_runs.incident_id > ops.incidents.id
Ref incident_runs_execution_id: ops.incident_runs.execution_id > ops.pipeline_executions.id
Ref pipeline_access_grants_pipeline_id: ops.pipeline_access_grants.pipeline_id > ops.pipelines.id
Ref recommendations_diagnosis_id: diagnosis.recommendations.diagnosis_id > diagnosis.diagnoses.id
Ref diagnosis_evidence_links_diagnosis_id: diagnosis.diagnosis_evidence_links.diagnosis_id > diagnosis.diagnoses.id
Ref diagnosis_source_links_diagnosis_id: diagnosis.diagnosis_source_links.diagnosis_id > diagnosis.diagnoses.id
Ref human_reviews_diagnostic_id: diagnosis.human_reviews.diagnostic_id > diagnosis.diagnoses.id
Ref knowledge_chunks_document_id: knowledge.knowledge_chunks.document_id > knowledge.knowledge_documents.id
Ref correlation_groups_confirmed_context_fk: evidence.correlation_groups.(id, confirmed_context_id) > evidence.correlated_contexts.(group_id, id)
Ref correlated_contexts_group_identity_fk: evidence.correlated_contexts.(group_id, incident_id, execution_id) > evidence.correlation_groups.(id, incident_id, execution_id)
Ref github_connections_active_generation_fk: ingestion.github_connections.(id, active_generation_id) > ingestion.github_connection_generations.(connection_id, id)
Ref github_attempts_identity_fk: ingestion.github_authorization_attempts.(connection_id, tenant_id, entra_object_id) > ingestion.github_connections.(id, tenant_id, entra_object_id)
Ref github_attempts_expected_generation_fk: ingestion.github_authorization_attempts.(connection_id, expected_generation_id) > ingestion.github_connection_generations.(connection_id, id)
Ref github_attempts_target_generation_fk: ingestion.github_authorization_attempts.(connection_id, target_generation_id) > ingestion.github_connection_generations.(connection_id, id)
Ref github_operations_generation_fk: ingestion.github_credential_operations.(connection_id, generation_id) > ingestion.github_connection_generations.(connection_id, id)
Ref capture_receipts_observation_fk: ingestion.capture_receipts.(capture_domain, source, observation_id) > ingestion.capture_observations.(capture_domain, source, id)
Ref capture_aliases_receipt_fk: ingestion.capture_delivery_aliases.(capture_domain, source, receipt_id) > ingestion.capture_receipts.(capture_domain, source, id)
Ref capture_observations_origin_fk: ingestion.capture_observations.(capture_domain, source, origin_receipt_id) > ingestion.capture_receipts.(capture_domain, source, id)
Ref publication_outputs_observation_fk: ingestion.publication_outputs.(observation_id) > ingestion.capture_observations.(id)

TableGroup ops {
  ops.repositories
  ops.pipelines
  ops.pipeline_executions
  ops.execution_stages
  ops.incidents
  ops.incident_runs
  ops.pipeline_access_grants
}

TableGroup evidence {
  evidence.evidence_items
  evidence.correlation_groups
  evidence.correlated_contexts
  evidence.correlation_receipts
}

TableGroup diagnosis {
  diagnosis.correlated_context_receipts
  diagnosis.diagnoses
  diagnosis.recommendations
  diagnosis.diagnosis_evidence_links
  diagnosis.diagnosis_source_links
  diagnosis.human_reviews
}

TableGroup knowledge {
  knowledge.knowledge_documents
  knowledge.knowledge_chunks
}

TableGroup audit {
  audit.audit_events
}

TableGroup ingestion {
  ingestion.github_connections
  ingestion.github_connection_generations
  ingestion.github_authorization_attempts
  ingestion.github_credential_operations
  ingestion.capture_receipts
  ingestion.capture_delivery_aliases
  ingestion.capture_observations
  ingestion.publication_outputs
}
